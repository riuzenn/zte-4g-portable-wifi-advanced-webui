export TOOLCHAIN=${HOME}/usr
export CROSS_COMPILE=${TOOLCHAIN}/bin/arm-buildroot-linux-uclibcgnueabi-
export SYSROOT=${TOOLCHAIN}/arm-buildroot-linux-uclibcgnueabi/sysroot
export ZTE_LIB=${HOME}/ztelib

export CC="${CROSS_COMPILE}gcc"
export STRIP="${CROSS_COMPILE}strip"

export CFLAGS="-Wextra -Os -mcpu=cortex-a53 -mtune=cortex-a53 -mfloat-abi=soft -mthumb -fno-unwind-tables -fno-asynchronous-unwind-tables -fno-ident -fomit-frame-pointer -ffunction-sections -fdata-sections -fvisibility=hidden --sysroot=${SYSROOT} -fno-pie -fno-stack-protector -falign-functions=2 -falign-loops=2 -falign-jumps=2"

export LDFLAGS="-mcpu=cortex-a53 -mtune=cortex-a53 -Wl,--as-needed -Wl,--no-copy-dt-needed-entries -L${ZTE_LIB} -Wl,-rpath-link=${ZTE_LIB} -Wl,-O2 -Wl,--gc-sections -Wl,-dynamic-linker,/lib/ld-uClibc.so.0 -Wl,-z,max-page-size=4096 -Wl,--no-undefined -Wl,--no-allow-shlib-undefined -Wl,-z,norelro -Wl,-z,lazy -Wl,-t"

export LIBS="-lsoftap -lnvram -lsoft_timer"

${CC} ${CFLAGS} at.c -o at ${LDFLAGS} ${LIBS}

ls -l at
file at
readelf -h at
readelf -A at
readelf -d at | grep NEEDED
readelf -h at | grep Type
readelf -l at | grep GNU_RELRO
readelf -d at | grep BIND_NOW
readelf -s at | grep stack_chk
readelf -r at | grep stack_chk
readelf -l at | grep GNU_STACK

${STRIP} --strip-all -R .note -R .comment -R .gnu_debuglink -R .gnu_debugdata at
~/ELFkickers/sstrip/sstrip at
ls -l at

