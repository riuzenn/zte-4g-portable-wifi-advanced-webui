cd ~
git clone https://github.com/crigler/dtach ~/dtach_build
cd ~/dtach_build

sed -i 's/"dtach - version %s, compiled on %s at %s\.\\n"/"dtach - version %s.\\n"/g' main.c

make distclean
export TOOLCHAIN=${HOME}/usr
export CROSS_COMPILE=${TOOLCHAIN}/bin/arm-buildroot-linux-uclibcgnueabi-
export SYSROOT=${TOOLCHAIN}/arm-buildroot-linux-uclibcgnueabi/sysroot
export ZTE_LIB=${HOME}/ztelib

export CC="${CROSS_COMPILE}gcc"
export AR="${CROSS_COMPILE}gcc-ar"
export RANLIB="${CROSS_COMPILE}gcc-ranlib"
export STRIP="${CROSS_COMPILE}strip"

export CFLAGS="-I. -Wextra -Os -mcpu=cortex-a53 -mtune=cortex-a53 -mfloat-abi=soft -mthumb -fno-unwind-tables -fno-asynchronous-unwind-tables -fno-ident -fomit-frame-pointer -ffunction-sections -fdata-sections -fvisibility=hidden --sysroot=${SYSROOT} -fno-pie -fno-stack-protector -flto=$(nproc) -falign-functions=2 -falign-loops=2 -falign-jumps=2"

export LDFLAGS="-mcpu=cortex-a53 -mtune=cortex-a53 -Wl,--as-needed -Wl,--no-copy-dt-needed-entries -L${ZTE_LIB} -Wl,-rpath-link=${ZTE_LIB} -Wl,-O2 -Wl,--gc-sections -Wl,-dynamic-linker,/lib/ld-uClibc.so.0 -Wl,-z,max-page-size=4096 -Wl,--no-undefined -Wl,--no-allow-shlib-undefined -Wl,-z,norelro -Wl,-z,lazy -Wl,-t -Wl,-Map,aaa.map -flto=$(nproc)"

export LD_LIBRARY_PATH=~/usr/lib:$LD_LIBRARY_PATH

export LIBS=""

./configure --host=arm-buildroot-linux-uclibcgnueabi

make V=1 dtach CC="${CC}" CFLAGS="${CFLAGS}" LDFLAGS="${LDFLAGS}" -j$(nproc) > ~/1.txt 2>&1

ls -l dtach
file dtach
readelf -d dtach | grep NEEDED
readelf -h dtach | grep Type
readelf -l dtach | grep GNU_RELRO
readelf -d dtach | grep BIND_NOW
readelf -s dtach | grep stack_chk
readelf -r dtach | grep stack_chk
readelf -l dtach | grep GNU_STACK

${STRIP} --strip-all -R .note -R .comment -R .gnu_debuglink -R .gnu_debugdata dtach
~/ELFkickers/sstrip/sstrip dtach
ls -l dtach
