cd ~
wget https://curl.se/download/curl-8.22.0.tar.bz2
tar -jxf curl-8.22.0.tar.bz2
mv curl-8.22.0 curl_build
cd ~/curl_build

#替换修改后的wolfssl.c到curl_build/lib/vtls
make distclean
export TOOLCHAIN=${HOME}/usr
export CROSS_COMPILE=${TOOLCHAIN}/bin/arm-buildroot-linux-uclibcgnueabi-
export SYSROOT=${TOOLCHAIN}/arm-buildroot-linux-uclibcgnueabi/sysroot
export ZTE_LIB=${HOME}/ztelib

export CC="${CROSS_COMPILE}gcc"
export AR="${CROSS_COMPILE}gcc-ar"
export RANLIB="${CROSS_COMPILE}gcc-ranlib"
export STRIP="${CROSS_COMPILE}strip"

export CFLAGS="-Wextra -Os -mcpu=cortex-a53 -mtune=cortex-a53 -mfloat-abi=soft -mthumb -fno-unwind-tables -fno-asynchronous-unwind-tables -fno-ident -fomit-frame-pointer -ffunction-sections -fdata-sections -fvisibility=hidden --sysroot=${SYSROOT} -fno-pie -fstack-protector-strong -flto=$(nproc) -falign-functions=2 -falign-loops=2 -falign-jumps=2"

export LDFLAGS="-mcpu=cortex-a53 -mtune=cortex-a53 -Wl,--as-needed -Wl,--no-copy-dt-needed-entries -L${ZTE_LIB} -Wl,-rpath-link=${ZTE_LIB} -Wl,-O2 -Wl,--gc-sections -Wl,-dynamic-linker,/lib/ld-uClibc.so.0 -Wl,-z,max-page-size=4096 -Wl,--no-allow-shlib-undefined -Wl,-z,relro -Wl,-z,now -Wl,-t -Wl,-Map,aaa.map -flto=$(nproc)"

export LIBS=""

V=""
V="${V} --enable-static --disable-shared"
V="${V} --disable-manual --disable-docs"
# ---------- TLS 后端：只用 wolfSSL ----------
V="${V} --with-wolfssl=${ZTE_LIB}"
V="${V} --with-ca-bundle=/etc/cacert.pem"
V="${V} --without-gnutls --without-mbedtls"
V="${V} --without-rustls --without-schannel --without-amissl"
# ---------- 协议：只留 HTTP+HTTPS ----------
V="${V} --enable-http --disable-ftp --disable-file --disable-ipfs"
V="${V} --disable-ldap --disable-ldaps --disable-rtsp --disable-dict"
V="${V} --disable-telnet --disable-tftp --disable-smb --disable-smtp"
V="${V} --disable-pop3 --disable-imap --disable-gopher --disable-mqtt"
V="${V} --disable-websockets"
# ---------- 网络/解析 ----------
V="${V} --disable-ipv6 --disable-unix-sockets --disable-bindlocal --disable-socketpair"
V="${V} --disable-ares --disable-threaded-resolver --disable-dnsshuffle"
V="${V} --disable-doh --disable-ech --disable-httpsrr"
V="${V} --disable-ssls-export --disable-proxy-http3 --disable-proxy"
# ---------- HTTP 功能精简 ----------
V="${V} --disable-alt-svc --disable-hsts --disable-headers-api"
V="${V} --disable-mime --disable-form-api --disable-netrc"
V="${V} --disable-cookies --disable-dateparse"
V="${V} --disable-progress-meter --disable-verbose"
# ---------- 鉴权：只保留basic/bearer ----------
V="${V} --disable-digest-auth --disable-kerberos-auth --disable-negotiate-auth"
V="${V} --disable-aws --disable-httpsig --disable-ntlm"
# ---------- 杂项 ----------
V="${V} --disable-sspi --disable-sha512-256 --disable-typecheck"
V="${V} --disable-rt --disable-largefile"
V="${V} --disable-libcurl-option --disable-get-easy-options"
# ---------- 外部依赖全不要 ----------
V="${V} --with-zlib --without-libidn2 --without-libpsl"
V="${V} --without-brotli --without-zstd"
V="${V} --without-nghttp2 --without-ngtcp2 --without-nghttp3 --without-quiche"
V="${V} --without-libssh2 --without-libssh --without-libuv"
V="${V} --without-libgsasl --without-gssapi --without-winidn"

./configure --host=arm-buildroot-linux-uclibcgnueabi ${V}

make V=1 -j$(nproc) > ~/1.txt 2>&1
cd src
# 1) 各段大小
${CROSS_COMPILE}size -A curl
${CROSS_COMPILE}size -A curl | grep -E '\.(text|rodata|bss)\b'
# 2) 最大的符号
${CROSS_COMPILE}nm -S --size-sort curl
# 3) 链接图
find ~/curl_build -name aaa.map



ls -l curl
file curl
readelf -h curl
readelf -A curl
readelf -d curl | grep NEEDED
readelf -h curl | grep Type
readelf -l curl | grep GNU_RELRO
readelf -d curl | grep BIND_NOW
readelf -s curl | grep stack_chk
readelf -r curl | grep stack_chk
readelf -l curl | grep GNU_STACK

${STRIP} --strip-all -R .note -R .comment -R .gnu_debuglink -R .gnu_debugdata curl
~/ELFkickers/sstrip/sstrip curl
ls -l curl

